+package com.example.pet_shelter;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.*;
+import java.util.ArrayList;
+import java.util.List;
+
+public class NotificationManager {
+    private List<String> notifications;
+    private final String filePath; // Path to store notifications
+
+    // Constructor
+    public NotificationManager(String filePath) {
+        this.filePath = filePath;
+        this.notifications = new ArrayList<>();
+        loadNotificationsFromFile();
+    }
+
+    // Add a new notification
+    public void addNotification(String message) {
+        notifications.add(message);
+        System.out.println("Notification added: " + message);
+    }
+
+    // Get all notifications
+    public List<String> getNotifications() {
+        return notifications;
+    }
+
+    // Save notifications to a JSON file
+    public void saveNotificationsToFile() {
+        JSONArray jsonArray = new JSONArray();
+        for (String notification : notifications) {
+            JSONObject obj = new JSONObject();
+            obj.put("message", notification);
+            jsonArray.put(obj);
+        }
+
+        try (FileWriter writer = new FileWriter(filePath)) {
+            writer.write(jsonArray.toString(4)); // Indented JSON format
+            System.out.println("Notifications saved to file.");
+        } catch (IOException e) {
+            System.out.println("Error saving notifications: " + e.getMessage());
+        }
+    }
+
+    // Load notifications from a JSON file
+    private void loadNotificationsFromFile() {
+        File file = new File(filePath);
+        if (!file.exists()) {
+            System.out.println("No existing notification file found.");
+            return;
+        }
+
+        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+            StringBuilder jsonString = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                jsonString.append(line);
+            }
+
+            JSONArray jsonArray = new JSONArray(jsonString.toString());
+            for (int i = 0; i < jsonArray.length(); i++) {
+                JSONObject obj = jsonArray.getJSONObject(i);
+                notifications.add(obj.getString("message"));
+            }
+            System.out.println("Notifications loaded from file.");
+        } catch (IOException e) {
+            System.out.println("Error loading notifications: " + e.getMessage());
+        }
+    }
+}
